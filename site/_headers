# Security headers for the project site, in Cloudflare's _headers format (GitHub Pages cannot send them).
# The site loads nothing from other origins and runs only its own scripts, so everything else is refused.
# Its fonts are the console's own files, served from fonts/ (font-src 'self'); it plays no media.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The fonts carry their content's hash in their names; the licence texts beside them do not.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# The not-found page's coin and shadow carry their content's hash in their names: a changed image is a new name.
/hero/*
  Cache-Control: public, max-age=31536000, immutable

# did:web:polaris-id.org resolves to this document; a resolver running in a browser reads it from another origin.
/.well-known/did.json
  Access-Control-Allow-Origin: *

# The Web Key Directory (direct method): an OpenPGP client finds security@polaris-id.org's key here.
/.well-known/openpgpkey/*
  Access-Control-Allow-Origin: *
/.well-known/openpgpkey/hu/*
  Content-Type: application/octet-stream
