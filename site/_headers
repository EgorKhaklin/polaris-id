# Security headers for the project site, in Cloudflare's _headers format (GitHub Pages cannot send them).
# The site loads nothing from other origins and runs no script, so almost everything is refused.
# Its fonts are the console's own files, served from fonts/ (font-src 'self'); it plays no media.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The fonts carry their content's hash in their names; the licence texts beside them do not.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# The hero's images carry their content's hash in their names: a changed image is a new name.
/hero/*
  Cache-Control: public, max-age=31536000, immutable

# The acts' images carry their content's hash in their names too.
/film/*
  Cache-Control: public, max-age=31536000, immutable
