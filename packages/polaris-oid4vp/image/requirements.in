# What the polaris-oid4vp image installs: the released package, from PyPI, and what it needs.
# requirements.txt is compiled from this with hashes:
#   pip-compile --generate-hashes --allow-unsafe --strip-extras requirements.in
# and installed with pip install --require-hashes --only-binary :all: -r requirements.txt.
# The image's tag is this version with a v in front: a new package release is a new version on
# the line below and a new image tag. A rebuild of the same release is tagged with a revision
# (v1.1.0-2); no tag is published twice.
polaris-oid4vp==1.1.0
