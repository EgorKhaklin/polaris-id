# Coverage config for scripts/polaris-coverage.sh (roadmap P0.8).
# Measures PRODUCT coverage: the test files, venvs, and generated code are
# omitted so the number reflects how much of the shipped code the suites
# exercise, not how much of the tests run.
[run]
branch = false
parallel = true
omit =
    */test_*.py
    */tests/*
    */venv/*
    */__pycache__/*
    */witness2/poseidon_constants.py
    polaris_checks/run.py
    # The subprocess-coverage bootstrap polaris-coverage.sh drops in a temp dir; it
    # is not product code, and recording it leaves a dangling source reference
    # once the temp dir is cleaned (a "No source for code" report error).
    */sitecustomize.py
    # Test infrastructure, not product code (P1.2/P1.3).
    */kms_standin.py
    # Third-party code. The standalone suites under scripts/ measure without --source (see
    # run_standalone in polaris-coverage.sh), so the interpreter's own package directories
    # are named explicitly rather than left to depend on where the runner installed them.
    */site-packages/*
    */dist-packages/*
    */.tox/*

[report]
# The CLI entrypoints are exercised end to end (the app shells into the ZK
# binary; polaris_checks.run gates CI) rather than by unit tests, so counting
# them as "uncovered" would understate the product coverage. They are omitted
# above and exercised by integration.
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
skip_empty = true
