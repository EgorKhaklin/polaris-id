# Coverage config for scripts/polaris-coverage.sh (roadmap P0.8).
# Measures PRODUCT coverage: the test files, venvs, and generated code are
# omitted so the number reflects how much of the shipped code the suites
# exercise, not how much of the tests run. Statements and branches are both
# measured (2026-09-29), and the script gates each on its own floor.
[run]
branch = true
parallel = true
omit =
    */test_*.py
    */tests/*
    */venv/*
    */__pycache__/*
    */witness2/poseidon_constants.py
    # The checks' command-line entry; the layer itself is measured. The pattern needs the
    # leading */ because coverage matches absolute paths: without it this never matched.
    */polaris_checks/run.py
    # The subprocess-coverage bootstrap polaris-coverage.sh drops in a temp dir; it
    # is not product code, and recording it leaves a dangling source reference
    # once the temp dir is cleaned (a "No source for code" report error).
    */sitecustomize.py
    # Scripts a test writes into a temp dir and runs: the conformance runner's fake verifier,
    # the tree gate's stub stages (its scratch repositories and the gate's own exports of them),
    # the duress test's worker, and the stand-in `oqs` module the verifier and SDK tests put
    # first on PYTHONPATH. CI combines the coverage shards on another runner, where those temp
    # dirs never existed: recorded, each is a "No source for code" report error.
    */polaris-runner-test-*/*
    */polaris-tree-*/*
    */tmp*/worker.py
    */polaris-oqs-stub-*/*
    # The govulncheck step tests' stand-in `docker`.
    */polaris-govulncheck-step-*/*
    # Test infrastructure, not product code (P1.2/P1.3).
    */kms_standin.py
    # Third-party code. The standalone suites under scripts/ measure without --source (see
    # run_standalone in polaris-coverage.sh), so the interpreter's own package directories
    # are named explicitly rather than left to depend on where the runner installed them.
    */site-packages/*
    */dist-packages/*
    */.tox/*
    # Tooling that entered the denominator only because a test imports it: the ship tool,
    # the suite and drill runners, the load generator and the test PKI. None of it ships.
    */scripts/polaris-ship.py
    */scripts/polaris-app-role-suite.py
    */scripts/polaris-real-signer-suite.py
    */scripts/polaris-schema-drift-drill.py
    */scripts/polaris_bounded_run.py
    */scripts/polaris_changed_base.py
    */scripts/polaris-verify-load.py
    */scripts/polaris-credential-copy-test-pki.py

[paths]
# polaris_cli/test_cli.py's PackageInstallTests runs a COPY of polaris_cli from a temporary
# directory, as an installed package runs. Its lines are polaris_cli's own, so they are folded back
# into polaris_cli/ here. Left unmapped, the copy is gone by the time the data is combined, and
# `coverage json` fails with "No source for code": from 2026-09-30 to 2026-10-08 that left CI's
# floors comparing empty numbers, and passing.
polaris_cli =
    polaris_cli/
    */polaris-cli-pkg-*/site/polaris_cli/
# scripts/test_restore_schema_check.py runs the backup and restore scripts from temporary copies of
# the tree (/tmp/polaris-rds-*/tree-extra/scripts/ and the like) and removes them afterwards: the
# same fold, or `coverage json` fails on polaris_db_settings.py's copy. scripts/test_ci_changes.py
# runs the classifier over a scratch repository holding a copy of polaris-sdk-mutation-drill.py
# (/tmp/polaris-ci-changes-*/scripts/): the same fold.
scripts =
    scripts/
    */polaris-r*-*/*/scripts/
    */polaris-ci-changes-*/scripts/

[report]
# The CLI entrypoints are exercised end to end (the app shells into the ZK
# binary; polaris_checks.run gates CI) rather than by unit tests, so counting
# them as "uncovered" would understate the product coverage. They are omitted
# above and exercised by integration.
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
skip_empty = true
