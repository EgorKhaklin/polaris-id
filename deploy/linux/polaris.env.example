# /etc/polaris/polaris.env: systemd EnvironmentFile for polaris.service (P1.1).
# Written by deploy/linux/install.sh; edit and `systemctl restart polaris`.
# Mode 0600, owner root: nothing in here is a secret, but keep it that way.

# REQUIRED. The public hostname. Caddy provisions a Let's Encrypt certificate
# for it, so its DNS A/AAAA record must point at this host and 80/443 must be
# reachable from the internet before the first start.
POLARIS_DOMAIN=polaris.example.org

# gunicorn workers (default 4). Roughly 2 x vCPU.
WEB_CONCURRENCY=4

# Where the Atlas basemap comes from. Empty = CARTO's free dark-matter style,
# which the operator's browser fetches from basemaps.cartocdn.com on that one
# page (the viewport of an investigation leaves the estate). Set a self-hosted
# MapLibre style URL to keep it inside; the Atlas CSP admits that origin instead.
POLARIS_ATLAS_BASEMAP_STYLE_URL=

# Continuous WAL archiving (docs/operator/DR.md section 5), on by default (lab
# record 017, gate row OP-14): the archive goes to the local pgbackrest_repo
# volume, which a point-in-time restore and the weekly restore check read. It
# does not survive the host, so configure the offsite repo below as well. 0 turns
# archiving off, and point-in-time restore with it.
POLARIS_PGBACKREST_ENABLED=1
# Offsite backup repo by env alone (roadmap P0.9). The S3 key pair is NOT here:
# it is polaris_web/secrets/pgbackrest_repo_creds.conf.
POLARIS_PGBACKREST_S3_BUCKET=
POLARIS_PGBACKREST_S3_ENDPOINT=
POLARIS_PGBACKREST_S3_REGION=
POLARIS_PGBACKREST_S3_PATH=
POLARIS_PGBACKREST_S3_PORT=
POLARIS_PGBACKREST_S3_URI_STYLE=
POLARIS_PGBACKREST_S3_CA_FILE=

# Extra compose files for polaris.service AND polaris-deploy.sh. Recommended on
# a real server: "-f docker-compose.bluegreen.yml" (zero-downtime app deploys,
# roadmap P1.4). CI adds "-f docker-compose.citest.yml" (internal-CA edge).
POLARIS_COMPOSE_EXTRA=

# Sealed secret store (roadmap P1.3). file = the plaintext directory
# polaris_web/secrets is the store (default). age / awskms = the store is
# polaris_web/secrets.sealed and plaintext is unsealed into POLARIS_SECRETS_DIR
# (a tmpfs) at every start. docs/operator/SECRETS.md section 5 (The sealed
# secret store).
POLARIS_SECRETS_BACKEND=file
# Leave EMPTY with the file backend: compose then reads ./secrets. With age or
# awskms the unseal defaults this to /run/polaris/secrets (a tmpfs). Setting it
# with the file backend points compose at a directory nothing populates, and
# polaris.service fails at start (found by the v9.180 CI install run).
POLARIS_SECRETS_DIR=
# age: the identity that decrypts (0600, root-only; or an age plugin for a
# hardware token) and the recipients file used to seal.
POLARIS_SECRETS_AGE_IDENTITY=
POLARIS_SECRETS_AGE_RECIPIENTS=
# awskms: the symmetric KMS key that wraps the per-file data keys.
POLARIS_SECRETS_AWSKMS_KEY_ID=
POLARIS_SECRETS_AWSKMS_REGION=

# Session and origin hardening (roadmap P1.7, v9.189). All optional; a bad
# value refuses the start. docs/operator/HARDENING.md section 13.
# Per-role allow-lists (comma-separated CIDRs or addresses) for logging in and
# for keeping a live session; unset = any address. X-Forwarded-For counts only
# behind the edge (POLARIS_TRUST_PROXY, which the compose stack sets).
#POLARIS_NETWORK_POLICY_ADMIN=10.20.0.0/16,203.0.113.7
#POLARIS_NETWORK_POLICY_OPERATOR=
#POLARIS_NETWORK_POLICY_AUDITOR=
# Concurrent live sessions per account (0 = unlimited; admin defaults to 3, the
# least-recently-seen seat is evicted) and idle timeouts in minutes (0 = none;
# admin defaults to 30).
#POLARIS_SESSION_MAX_ADMIN=3
#POLARIS_SESSION_IDLE_MINUTES_ADMIN=30
#POLARIS_SESSION_MAX_OPERATOR=0
#POLARIS_SESSION_IDLE_MINUTES_OPERATOR=0
# WebAuthn attestation policy (docs/operator/WEBAUTHN-ROLLOUT.md Phase 6):
# none|indirect|direct|enterprise; preferred|required|discouraged; 1 to refuse
# enrollments without a verifiable attestation; comma-separated authenticator
# AAGUIDs to allow; 1 to refuse platform authenticators.
#POLARIS_WEBAUTHN_ATTESTATION=none
#POLARIS_WEBAUTHN_USER_VERIFICATION=preferred
#POLARIS_WEBAUTHN_REQUIRE_ATTESTATION=
#POLARIS_WEBAUTHN_ALLOWED_AAGUIDS=
#POLARIS_WEBAUTHN_HARDWARE_ONLY=
#POLARIS_WEBAUTHN_RP_NAME=Polaris
