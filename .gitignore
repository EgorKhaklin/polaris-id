# Polaris — .gitignore
#
# One rule when editing this file: a pattern must not carry a trailing inline
# comment. Git does not strip them, so `polaris.env  # secrets` ignores nothing
# and leaves the secrets tracked. Put the comment on its own line, above.

# ============================================================================
# macOS metadata
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments, wherever someone creates one
venv/
.venv/
env/
.env

# Test, coverage, type-checker and linter caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ============================================================================
# Rust (polaris_zk/)
# ============================================================================
target/
Cargo.lock.bak
**/*.rs.bk

# ============================================================================
# Node and JavaScript
# The map library is vendored under polaris_web/static/vendor/; nothing is
# installed in-repo. These guard against accidental npm activity.
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================================
# Editor and IDE state, all of it per-user
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
.claude/

# ============================================================================
# Shell and process artifacts
# ============================================================================
*.log
*.pid
*.seed
*.pid.lock
.history

# ============================================================================
# Runtime state
# The launcher and the development server write here (POLARIS_STATE_DIR,
# which defaults under /tmp). None of it is source.
# ============================================================================
polaris-state/
state/
polaris_web/docker-state/
polaris_web/.docker-volume/
.playwright-mcp/

# The performance baseline writes JSON on every run; the document that
# records the numbers is the artifact under version control.
perf-baseline.json

# ============================================================================
# Secrets, none of which belong in this repository
# ============================================================================
.env
.env.local
.env.*.local
polaris.env
secrets.json
credentials.json

# Generated by scripts/polaris-generate-secrets.sh and file-mounted by the
# production compose stack; rotated by polaris-rotate-secret.sh. These must
# never leave the host filesystem.
polaris_web/secrets/

# The sealed store, and the generation kept beside it during a rotation. Safe
# to keep in a private operations repository; never in this one.
polaris_web/secrets.sealed/
polaris_web/secrets.sealed.prev/

# ============================================================================
# LaTeX build products
# The report's .tex is source and its .pdf is committed as the version of
# record; everything the build writes alongside them is not.
# ============================================================================
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
.tla/

# TLC writes its fingerprint and state-queue files beside the spec it is checking.
# They reach a gigabyte on a large run and have no business in the tree; the drill
# points TLC at a scratch metadir, and this is the belt to that suspenders.
meta/tla/states/
