{
  "name": "polaris-sdk-ts",
  "version": "0.1.0",
  "description": "Server-side SDK to verify Polaris identity credentials (offline authenticity + online status).",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "conformance": "node src/conformance.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EgorKhaklin/polaris-id.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/EgorKhaklin/polaris-id/tree/main/sdk/typescript",
  "bugs": {
    "url": "https://github.com/EgorKhaklin/polaris-id/issues"
  },
  "keywords": [
    "identity",
    "credential",
    "verifier",
    "ml-dsa",
    "post-quantum",
    "sd-jwt",
    "openid4vp"
  ]
}
