# The toolchain publish.yml builds and checks the Python distributions with. requirements.txt
# is compiled from this with hashes:
#   pip-compile --generate-hashes --allow-unsafe --strip-extras requirements.in
# and installed with pip install --require-hashes; the build then runs --no-isolation, so the
# setuptools that builds a published wheel is this pinned one, not whatever PyPI serves that day.
build
setuptools>=68
