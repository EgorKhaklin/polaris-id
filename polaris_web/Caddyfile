# ============================================================================
# Polaris — Caddyfile (Arc B Phase 1, v8.77)
#
# Caddy 2 with automatic Let's Encrypt TLS issuance + renewal.
# G27: TLS is required. No HTTP-only production.
#
# The POLARIS_DOMAIN env var is interpolated at load time via {$POLARIS_DOMAIN}.
# HTTP on 8080 (host 80) redirects to HTTPS; TLS is served on 8443 (host 443).
# ============================================================================

{
    # Global options
    email admin@{$POLARIS_DOMAIN}
    # The admin API on a unix socket in /config (owned by the edge's own
    # user, never on the network): `caddy reload` through it applies a
    # Caddyfile change with no listener restart, so an edge configuration
    # change is no longer a window (v9.240). The Caddyfile is mounted
    # read-only, so nothing reached through the socket can persist.
    admin unix//config/admin.sock
    # v9.239 — the edge runs as uid 1000 with no capabilities, so it listens on
    # unprivileged ports; the host publishes 80/443 onto 8080/8443 (compose)
    # and the Service does the same (Helm). Caddy's automatic HTTP-to-HTTPS
    # redirect would name :8443 in its Location header when https_port is not
    # 443, so it is disabled and the http:// site at the end of this file
    # redirects to the domain without a port, as the client sees it. ACME
    # HTTP-01 is unaffected: the challenge handler is injected on http_port
    # regardless.
    http_port 8080
    https_port 8443
    auto_https disable_redirects
    # Logs go to stdout, where the json-file driver caps and rotates them
    # (compose) or the cluster collects them (Helm). A file under /var/log/caddy
    # needed a host directory writable by the container's user; stdout does not.
    log {
        output stdout
        format json
        level INFO
    }
    servers {
        protocols h1 h2 h3
        # Hide Caddy version from Server header
        metrics
        # Lab record 017 (OP-26): the load balancer in front of this edge, if any, named by
        # address range in POLARIS_TRUSTED_PROXIES. Behind it {client_ip} is read from
        # X-Forwarded-For right to left, past the named hops only (strict), so a client
        # cannot name its own address. Unset, no proxy is trusted (0.0.0.0/32) and
        # {client_ip} is the TCP peer.
        trusted_proxies static {$POLARIS_TRUSTED_PROXIES:0.0.0.0/32}
        trusted_proxies_strict
    }
}

# Main site
{$POLARIS_DOMAIN} {

    # The two metrics surfaces carry the duress signal, and neither
    # authenticates: whoever can scrape them can observe that, and roughly
    # when, a duress alarm fired. Restrict them here, at the edge, to the
    # monitoring network. The default allows private ranges only (an
    # in-network Prometheus scrapes; the public internet gets 404, which
    # does not even confirm the surface exists). Override with
    # POLARIS_METRICS_ALLOW, for example "10.20.0.0/16".
    @metrics_from_outside {
        path /metrics /api/metrics
        not remote_ip {$POLARIS_METRICS_ALLOW:private_ranges}
    }
    respond @metrics_from_outside 404

    # Reverse proxy to the Polaris app (gunicorn :8000 inside the network)
    reverse_proxy {$POLARIS_UPSTREAMS:app:8000} {
        header_up X-Real-IP {client_ip}
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # v9.183 (roadmap P1.4) — the upstream list comes from POLARIS_UPSTREAMS
        # (one app by default; "app:8000 app-green:8000" under the blue-green
        # overlay). A request that hits an upstream being recreated is retried
        # on the other for up to lb_try_duration, active liveness runs every 2s,
        # and a failed upstream is skipped for fail_duration: a rolling deploy
        # drops no requests (proven by scripts/polaris-rolling-drill.sh in CI).
        lb_policy round_robin
        lb_try_duration 15s
        lb_try_interval 250ms
        fail_duration 10s
        health_uri /api/health/ready
        health_interval 2s
        health_timeout 2s

        # Standard timeouts
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }
    }

    # Compression
    encode gzip zstd

    # Security headers (defense in depth — app also sets CSP)
    header {
        # HSTS — 2 years + preload (G27 / production-only)
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

        # Anti-clickjacking
        X-Frame-Options "DENY"

        # MIME-sniffing protection
        X-Content-Type-Options "nosniff"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Permissions policy — Polaris doesn't use any sensitive APIs
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

        # Cross-origin isolation
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"

        # Hide infrastructure
        -Server
        -X-Powered-By
    }

    # Rate limit — 200 req/min/IP global (defends against brute-force at the edge)
    # The app layer adds finer-grained limits via security.py (R8-2).
    rate_limit {
        zone polaris_global {
            key {client_ip}
            events 200
            window 1m
        }
    }

    # Cache static assets aggressively (app sends them with ?v=hash query strings)
    @static path /static/*
    handle @static {
        header Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy {$POLARIS_UPSTREAMS:app:8000} {
            lb_try_duration 15s
            lb_try_interval 250ms
            fail_duration 10s
        }
    }

    # Block common probes (reduce log noise + minor security)
    @blocked {
        path /.env /.git/* /wp-login.php /wp-admin/* /xmlrpc.php /phpmyadmin/*
    }
    respond @blocked 404

    # Access logging: stdout, capped and rotated by the json-file driver.
    log {
        output stdout
        format json
    }
}

# HTTP-to-HTTPS redirect, written out rather than left to Caddy: with
# https_port 8443 the automatic redirect would send clients to :8443, which
# only exists inside the container. This site binds http_port (8080) and
# redirects to the domain on the port the client used (443).
http://{$POLARIS_DOMAIN} {
    redir https://{$POLARIS_DOMAIN}{uri} permanent
}
