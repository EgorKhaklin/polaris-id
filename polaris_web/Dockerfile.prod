# ============================================================================
# Polaris — Production Dockerfile (multi-stage)
#
# Built under Arc B Phase 1 (v8.77). Distinct from `Dockerfile` (dev) in:
#   - Multi-stage build: builder + runtime (smaller final image)
#   - Optional ZK prover (Plonky2 / Rust nightly) bundled at /opt/polaris/zk
#   - Non-root `polaris` user (uid 1000)
#   - No dev tools or shell utilities in the runtime layer
#   - Strict `PYTHONDONTWRITEBYTECODE` + `PYTHONUNBUFFERED`
#   - Healthcheck via /api/health (structured JSON; v8.77)
#
# Build (CONTEXT IS THE REPO ROOT — the zk-builder stage COPYs polaris_zk/, a
# sibling of polaris_web/, and Docker COPY cannot escape the build context, so a
# polaris_web/ context cannot reach it. All app-file COPYs below are therefore
# repo-root-relative, e.g. polaris_web/app.py. docker-compose.prod.yml sets
# `context: ..`):
#     docker build -f polaris_web/Dockerfile.prod -t polaris-app:prod .
#     docker build -f polaris_web/Dockerfile.prod --build-arg POLARIS_ZK_BUILD=0 -t polaris-app:prod-noverify .
#
# G-guard alignment:
#   G3  (read-only watchers)     — n/a at image layer
#   G27 (TLS required in prod)   — enforced at compose layer, not here
#   G28 (no secrets in env)      — Dockerfile does NOT set sensitive env vars
# ============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Rust builder (Plonky2 ZK prover)
# ---------------------------------------------------------------------------
FROM rustlang/rust:nightly-bookworm-slim@sha256:28a36fae9485d8ca5d4f345ab8f89f1a530c7985381c0304efe259cec29f48ec AS zk-builder

ARG POLARIS_ZK_BUILD=1

WORKDIR /build
COPY polaris_zk/ ./polaris_zk/

RUN if [ "${POLARIS_ZK_BUILD}" = "1" ]; then \
      cd polaris_zk && cargo +nightly build --release && \
      cp target/release/polaris-zk /build/polaris-zk; \
    else \
      echo '#!/bin/sh' > /build/polaris-zk && \
      echo 'echo "zk-binary not built (POLARIS_ZK_BUILD=0)"; exit 1' >> /build/polaris-zk && \
      chmod +x /build/polaris-zk; \
    fi

# ---------------------------------------------------------------------------
# Stage 2: Python builder (deps to a virtual env we can copy)
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS py-builder

# Acquire::Retries survives a Debian mirror serving a partial file mid-sync,
# which failed a release build once. See scripts/polaris-image-build.sh.
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        cmake \
        ninja-build \
        git \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# v9.05 / Wave 1 / C3: pinned via requirements.txt for reproducibility.
# (Pre-v9.05 listed 5 packages with loose version specs inline.)
COPY polaris_web/requirements.txt /tmp/requirements.txt
# (v9.190: redis is an exact pin in requirements.txt now; the separate
# redis 5 install that used to follow here was a second source of truth.)
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# v9.116 — Real post-quantum signing in production. liboqs-python builds the
# liboqs C library from source (to /root/_oqs) on first import; we trigger that
# here so the runtime stage can copy the prebuilt library and never needs a
# compiler. With this present + POLARIS_USE_REAL_PQC=1 (set in the prod compose),
# issuance signs with real ML-DSA-65 instead of the SHA3-256 placeholder.
RUN pip install --no-cache-dir liboqs-python \
    && python -c "import oqs; print('liboqs', oqs.oqs_version(), 'built into the image')"

# v9.178 (roadmap P1.2) — optional key-custody drivers (python-pkcs11 for an
# HSM / PKCS#11 token, boto3 for AWS KMS). Off by default so the image stays
# small; build with --build-arg POLARIS_CUSTODY_EXTRAS=1 when the issuer key
# lives behind one of them. The file driver needs nothing extra.
ARG POLARIS_CUSTODY_EXTRAS=0
COPY polaris_web/requirements-custody.txt /tmp/requirements-custody.txt
RUN if [ "$POLARIS_CUSTODY_EXTRAS" = "1" ]; then pip install --no-cache-dir -r /tmp/requirements-custody.txt; fi

# ---------------------------------------------------------------------------
# Stage 3: Runtime (minimal Debian-slim, non-root)
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS runtime

LABEL org.opencontainers.image.title="Polaris (production)"
LABEL org.opencontainers.image.description="National identity token reference implementation"
LABEL org.opencontainers.image.source="https://github.com/EgorKhaklin/polaris-id"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# The version is passed in by scripts/polaris-image-build.sh, which reads it
# from polaris_web/__version__.py. It was a frozen literal until v9.215, by
# which point the image was labelling itself 137 versions behind the app.
ARG POLARIS_VERSION=0.0-unstamped
LABEL org.opencontainers.image.version="${POLARIS_VERSION}"

# v9.138 — apt-get upgrade pulls patched OS packages on top of the pinned base,
# clearing fixable CVEs in the base image (Trivy gates the built image on fixable
# CRITICAL). Then install the runtime deps.
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 -y upgrade \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        libpq5 \
        curl \
        ca-certificates \
        tini \
        libssl3 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Non-root user
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin polaris && \
    mkdir -p /opt/polaris /var/log/polaris && \
    chown -R polaris:polaris /opt/polaris /var/log/polaris

# Copy Python venv from py-builder
COPY --from=py-builder /opt/venv /opt/venv

# Copy the prebuilt liboqs C library (v9.116). liboqs-python looks for it under
# the running user's HOME (~/_oqs), so it lands in the polaris user's home. No
# compiler or build tools ship in the runtime; the library is already built.
COPY --from=py-builder --chown=polaris:polaris /root/_oqs /home/polaris/_oqs

# Copy ZK binary from zk-builder
COPY --from=zk-builder /build/polaris-zk /opt/polaris/zk
RUN chmod 0755 /opt/polaris/zk

# Application code:
#   anchoring.py    R10-2 Merkle helper
#   zk.py           R10-1 ZK wrapper
#   webauthn_auth.py v8.97 WebAuthn/MFA module (app.py imports it at startup;
#                   missing this caused the v8.97-onward image to ImportError)
#   __version__.py  v9.06 canonical POLARIS_VERSION source (app.py imports it)
#   tracing.py      v9.187 opt-in OTel distributed tracing (P1.6)
#   observability.py v9.31 metrics module (app.py + security.py import; v9.40
#                    fix — was missed because the regression-guard regex
#                    didn't tolerate trailing comments on the import line)
WORKDIR /app
COPY --chown=polaris:polaris polaris_web/app.py polaris_web/security.py polaris_web/gunicorn.conf.py ./
COPY --chown=polaris:polaris polaris_web/anchoring.py polaris_web/zk.py polaris_web/webauthn_auth.py polaris_web/__version__.py polaris_web/observability.py polaris_web/pqc_signing.py polaris_web/custody.py polaris_web/rp_auth.py polaris_web/tracing.py polaris_web/mdoc.py ./
COPY --chown=polaris:polaris polaris_web/templates/ ./templates/
COPY --chown=polaris:polaris polaris_web/static/   ./static/

# Non-sensitive runtime env (G28: nothing here is sensitive)
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POLARIS_ZK_BINARY=/opt/polaris/zk \
    POLARIS_PORT=8000 \
    POLARIS_STATE_DIR=/var/lib/polaris/state \
    WEB_CONCURRENCY=4

RUN mkdir -p /var/lib/polaris/state && chown polaris:polaris /var/lib/polaris/state

USER polaris

EXPOSE 8000

# Container HEALTHCHECK uses the LIVENESS probe (v9.108), not readiness: it
# answers "is this process alive?", so a transient DB/redis outage does not mark
# the container unhealthy and trigger a restart that cannot bring the dependency
# back. Readiness (the dependency roll-up) lives at /api/health/ready for the
# reverse proxy / orchestrator to gate traffic on.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl --fail --silent http://localhost:8000/api/health/live | grep -q '"status":"alive"' || exit 1

# tini handles signal forwarding + zombie reaping
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["gunicorn", "--config", "gunicorn.conf.py", "app:app"]
