# Dockerfile.postgres — Postgres 16 + pgBackRest for the Polaris prod stack
#
# v9.126+ (production-readiness, Wave 3): continuous WAL archiving needs
# pgBackRest installed ON the database host, because the primary's
# archive_command (`pgbackrest --stanza=polaris archive-push %p`) runs inside
# the postgres process. The stock postgres:16-alpine image has no pgbackrest, so
# we extend it. The base is digest-pinned (same digest the compose used as a
# bare image) so a mutated/deleted upstream tag cannot change what runs;
# Dependabot's docker ecosystem bumps it.
#
# Archiving is OPT-IN at runtime (docker-init.sh enables archive_mode +
# archive_command only when POLARIS_PGBACKREST_ENABLED is set), so a deployment
# that has not provisioned a repo does not accumulate WAL. The repo LOCATION is
# rendered at every container start by pg-entrypoint.sh -> pgbackrest-conf.sh
# into /etc/pgbackrest/conf.d/repo.conf: a local filesystem repo by default
# (what the CI round-trip exercises; NOT offsite), or an S3 bucket when the
# POLARIS_PGBACKREST_S3_* env is set (roadmap P0.9; what the CI offsite drill
# exercises against MinIO). The S3 credentials are a separately mounted secret
# fragment, never env. See docs/operator/DR.md.
#
# Build context is the REPOSITORY ROOT (see docker-compose.prod.yml).
# ============================================================================

# gosu, the base image's privilege-drop helper, is rebuilt from gosu's release source with
# Go 1.26.10 and replaces the base's copy (gosu 1.19, built with Go 1.24.6). The source is named
# by its release tag and checked against that tag's commit; the build flags are gosu's own
# (its Dockerfile's BUILD_FLAGS), and the module versions come from its go.mod, verified against
# its go.sum. gosu's release tags are not semver, so a local v<tag>.0 tag stamps the version into
# the binary the way gosu's own build does.
FROM golang:1.26.10-alpine3.24@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS compile
ARG GOSU_VERSION=1.20
ARG GOSU_COMMIT=29b939aa5bd4dc588af765b8248f6e39150d2565
RUN apk add --no-cache git
WORKDIR /src
RUN git clone --quiet --depth 1 --branch "$GOSU_VERSION" https://github.com/tianon/gosu.git .
RUN [ "$(git rev-parse HEAD)" = "$GOSU_COMMIT" ] \
    || { echo "gosu $GOSU_VERSION is commit $(git rev-parse HEAD), not $GOSU_COMMIT" >&2; exit 1; }
RUN git tag "v$GOSU_VERSION.0" \
    && CGO_ENABLED=0 go build -v -trimpath -ldflags '-d -w' -buildvcs=true -o /src/gosu github.com/tianon/gosu
# gosu's go.mod requires only go 1.20, so an older Go here would compile it without complaint:
# fail the build unless the binary reports go1.26.10 or a later release.
RUN v=$(go version /src/gosu | sed 's/^.*: go//'); \
    case "$v" in \
        1.26.1[0-9]|1.26.[2-9][0-9]|1.2[7-9].[0-9]*|1.[3-9][0-9].[0-9]*) echo "gosu: go$v" ;; \
        *) echo "gosu reports go$v, older than go1.26.10" >&2; exit 1 ;; \
    esac

FROM postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea

# Every Polaris image carries the same provenance labels; the version is
# passed in by scripts/polaris-image-build.sh from polaris_web/__version__.py.
LABEL org.opencontainers.image.title="Polaris (database)"
LABEL org.opencontainers.image.description="PostgreSQL for Polaris, with pgBackRest for the archive and restore path"
LABEL org.opencontainers.image.source="https://github.com/EgorKhaklin/polaris-id"
LABEL org.opencontainers.image.licenses="Apache-2.0"
ARG POLARIS_VERSION=0.0-unstamped
LABEL org.opencontainers.image.version="${POLARIS_VERSION}"


# v9.138 — apk upgrade pulls patched apk packages on top of the pinned base
# (clears fixable apk-package CVEs; gosu is not an apk package, so the compile
# stage above rebuilds it). pgbackrest is in the distro package set; the
# dirs are owned by the postgres user so the archive_command (run as postgres)
# and stanza ops can write them.
RUN apk upgrade --no-cache \
    && apk add --no-cache pgbackrest \
    && mkdir -p /var/lib/pgbackrest /etc/pgbackrest/conf.d /var/log/pgbackrest \
    && chown -R postgres:postgres /var/lib/pgbackrest /etc/pgbackrest /var/log/pgbackrest \
    && rm -rf /var/cache/apk/*

# The rebuilt gosu replaces the base's copy at the same path; the base's su-exec is a link to it.
COPY --from=compile /src/gosu /usr/local/bin/gosu
RUN [ "$(readlink /usr/local/bin/su-exec)" = gosu ] \
    && gosu --version \
    && gosu postgres true

# v9.243 (roadmap P2.7) — the HA supervisor lives in this image, so the HA
# profile (docker-compose.ha.yml) runs the SAME database image with a different
# command: polaris-patroni-entrypoint.sh renders Patroni's configuration from
# the compose environment and the file-mounted secrets and execs Patroni, which
# then owns initdb, replication, failover and pg_rewind. Python comes from the
# distro; Patroni and its client library are pinned in requirements-patroni.txt
# (Dependabot's pip ecosystem bumps them); pip leaves the image after the
# install. A container started with `postgres` (the default command, the
# single-node stack) never touches this layer.
COPY polaris_web/requirements-patroni.txt /tmp/requirements-patroni.txt
RUN apk add --no-cache python3 \
    && apk add --no-cache --virtual .pip py3-pip \
    && pip3 install --no-cache-dir --break-system-packages --require-hashes -r /tmp/requirements-patroni.txt \
    && apk del .pip \
    && rm -f /tmp/requirements-patroni.txt \
    && patroni --version
COPY --chmod=0755 polaris_web/patroni-entrypoint.sh /usr/local/bin/polaris-patroni-entrypoint.sh
COPY --chmod=0755 polaris_web/patroni-post-init.sh  /usr/local/bin/polaris-patroni-post-init.sh
# v9.173 (P0.9) — the repo-fragment renderer + the entrypoint wrapper that runs
# it on every start. conf.d is postgres-owned above so the renderer can write
# there whether the container starts as root (stock) or as postgres (restore).
COPY --chmod=0755 polaris_web/pgbackrest-conf.sh /usr/local/bin/polaris-pgbackrest-conf.sh
COPY --chmod=0755 polaris_web/pg-entrypoint.sh   /usr/local/bin/polaris-pg-entrypoint.sh

# v9.186 (roadmap P1.5) — the image is self-contained: the schema and its
# migrations, the init script, and the pgBackRest stanza config are baked in,
# so a Kubernetes pod needs no ConfigMaps for them. The compose stack keeps
# bind-mounting the live copies over these paths (dev freshness); the build
# context is therefore the repository root (see docker-compose.prod.yml).
COPY --chown=postgres:postgres polaris_sql /docker-entrypoint-initdb.d/sql
COPY --chmod=0755 polaris_web/docker-init.sh /docker-entrypoint-initdb.d/00-init.sh
COPY --chown=postgres:postgres polaris_web/pgbackrest.conf /etc/pgbackrest/pgbackrest.conf
# Lab record 017 (gate row OP-18): the migration runner, so a Kubernetes upgrade runs the migrations
# from this image as a Job (deploy/helm/polaris/templates/migrate-job.yaml). It finds them beside
# itself, at /opt/polaris/polaris_sql: the same files the init loads.
COPY --chmod=0755 scripts/polaris-migrate.sh /opt/polaris/scripts/polaris-migrate.sh
# The loader it sources (scripts/polaris-env.sh): on a systemd host it reads polaris.env; here, with no
# unit, it reads nothing. Without it the migration Job stopped at `source` (lab record 017).
COPY --chmod=0644 scripts/polaris-env.sh /opt/polaris/scripts/polaris-env.sh
RUN ln -s /docker-entrypoint-initdb.d/sql /opt/polaris/polaris_sql
# Lab record 017 (gate row OP-11): the restore check, which a one-off container of this image runs
# against the deployment's own repository (scripts/polaris-restore-verify.sh).
COPY --chmod=0755 scripts/polaris-restore-check.sh /opt/polaris/scripts/polaris-restore-check.sh
ENTRYPOINT ["/usr/local/bin/polaris-pg-entrypoint.sh"]
CMD ["postgres"]
