# ============================================================================
# Dockerfile.caddy — self-built Caddy edge for the Polaris prod stack
#
# v9.135. The prod Caddyfile uses the `rate_limit` directive (edge brute-force
# defense, 200 req/min/IP), which comes from the third-party caddy-ratelimit
# plugin. That plugin is NOT compiled into the stock `caddy:2-alpine` image, so
# the pinned stock image FAILED to load the Caddyfile:
#
#   Error: adapting config: Caddyfile:85: unrecognized directive: rate_limit
#
# i.e. the TLS edge container crash-looped on startup and the whole front door
# never came up. This builds Caddy from source with the plugin compiled in (the
# standard xcaddy pattern), exactly like the self-built pgbouncer (v9.110): no
# third-party prebuilt image, and every directive the Caddyfile uses is backed.
# The plugin is pinned to its release (v0.1.0, which the unversioned --with
# resolved to; lab record 017), so a new upstream tag changes nothing here
# until it is taken on purpose; Go's checksum database verifies the module.
#
# Both stages are digest-pinned (v9.114 discipline); Dependabot's docker
# ecosystem tracks the FROM digests. The runtime stage is the SAME image the
# compose pinned before (caddy:2.11.4-alpine = caddy:2-alpine @ 77c07d5e); we
# only swap the binary for one that includes the plugin.
#
# Build context is polaris_web/ (see docker-compose.prod.yml: context: .).
# ============================================================================
FROM caddy:2.11.4-builder-alpine@sha256:0aa610043dab5da82ad0a0268e46bb852785e6f5160f12f1c6fe3f42903d7e1b AS builder

# The Go toolchain has a FLOOR, as the modules below do. This builder digest ships
# Go 1.26.8, and the Go standard library is compiled into the binary: CVE-2026-56857
# (CRITICAL, os.Root's Mkdir and MkdirAll can follow junctions out of the root) is
# fixed in Go 1.26.9, and Trivy gates on fixable CRITICAL. GOTOOLCHAIN makes the go
# command fetch go1.26.10, which also carries crypto/x509 security fixes, from the
# module proxy, verified against the checksum database like the modules below.
# Remove it once Dependabot's builder digest carries Go >= 1.26.10 on its own.
ENV GOTOOLCHAIN=go1.26.10
# Fail the build once that is true: the line above forces go1.26.10, so a builder
# that ships a newer Go (or names none) would otherwise compile with the older one.
RUN case "$GOLANG_VERSION" in 1.26.[0-9]) ;; *) echo "builder ships Go $GOLANG_VERSION: remove GOTOOLCHAIN=go1.26.10" >&2; exit 1;; esac

# Compile the edge rate-limiter into the binary. Add future --with plugins here.
#
# The --replace lines are dependency FLOORS, not plugins. Caddy 2.11.4's module
# graph resolves each of these modules below the release that fixes an advisory
# against it, in Go's vulnerability database or in Trivy's report for the image.
# Each floor is that release, or the release another floor's module graph requires
# (x/net v0.62.0 requires x/crypto v0.58.0, otel/sdk v1.45.0 requires otel v1.45.0, and
# autoexport v0.70.0 brings compress v1.19.1), so no floor undercuts another:
#   golang.org/x/crypto            v0.58.0  GO-2026-6354, 6355 (ssh)
#   golang.org/x/net               v0.62.0  GO-2026-6603, 6610, 6611, 6612, 6617 (http2), 6860, 6866 (html)
#   google.golang.org/grpc         v1.83.2  GO-2026-6061, 6348, 6441, 6443; CVE-2026-84445
#   github.com/go-chi/chi/v5       v5.3.0   GO-2026-5774, 5775, 5777
#   github.com/klauspost/compress  v1.19.1  GO-2026-5841 (fixed in v1.18.7)
#   github.com/go-jose/go-jose/v4  v4.1.6   CVE-2026-116587
#   go.opentelemetry.io/otel       v1.45.0  GO-2026-5158
#   go.opentelemetry.io/otel/sdk   v1.45.0  GO-2026-6505
#   go.opentelemetry.io/otel/sdk/log                             v0.21.0  GO-2026-6615
#   go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc  v0.21.0  GO-2026-6508
#   go.opentelemetry.io/contrib/exporters/autoexport             v0.70.0  (the release built
#     for otel v1.45.0 and otel/log v0.21.0: 2.11.4's v0.68.0 keeps its stdout log exporter at
#     v0.19.0, which does not compile against otel/log v0.21.0)
# Each floor only raises its module: go version -m prints "dep <module> <resolved>"
# then "=> <module> <floor>", with the floor at or above the resolved version.
# x/crypto's floor first answered CVE-2026-56854 (CRITICAL, x/crypto/ssh), which
# `apk upgrade` cannot reach (the module is compiled into the binary) and which was
# linked in (227 x/crypto/ssh references in the binary), so .trivyignore was no
# answer. --with cannot express a floor for a module with no importable root package
# (x/crypto, x/net fail with "cannot find module providing package"); --replace
# writes a plain replace directive to go.mod, which is what xcaddy documents for
# this case. Remove the floors at the first Caddy release that carries
# caddyserver/caddy#8178 (c31d9a71) and passes scripts/polaris-edge-limits-drill.sh;
# the caddy entry in .github/dependabot.yml's ignore list says why the edge stays on
# 2.11.4 until then. A floor moves by hand to each module release that fixes an advisory
# against it; the weekly image scan fails on a fixable critical CVE in the binary.
# The binary keeps its symbol table, so govulncheck reads it at symbol level: xcaddy's
# default go build flags strip it (-ldflags "-w -s"), and XCADDY_GO_BUILD_FLAGS replaces
# all of them, so it restates the rest of xcaddy v0.4.5's defaults (-trimpath and its
# -tags list) and drops only -s.
ENV XCADDY_GO_BUILD_FLAGS="-ldflags=-w -trimpath -tags=nobadger,nomysql,nopgx"
# v9.342: the build fetches Go modules and verifies every one against the checksum
# database; that verification is never skipped (GOSUMDB stays on, GOFLAGS is not set).
# But the checksum database answered two CI builds in one day with an HTTP/2 stream
# error mid-download, which is a transient network failure, not a verification
# failure, so the build is retried a bounded number of times with a growing pause
# before the image (and every CI job that boots the stack) is declared broken.
RUN for attempt in 1 2 3 4; do \
        xcaddy build \
            --with github.com/mholt/caddy-ratelimit@v0.1.0 \
            --replace golang.org/x/crypto=golang.org/x/crypto@v0.58.0 \
            --replace golang.org/x/net=golang.org/x/net@v0.62.0 \
            --replace google.golang.org/grpc=google.golang.org/grpc@v1.83.2 \
            --replace github.com/go-chi/chi/v5=github.com/go-chi/chi/v5@v5.3.0 \
            --replace github.com/klauspost/compress=github.com/klauspost/compress@v1.19.1 \
            --replace github.com/go-jose/go-jose/v4=github.com/go-jose/go-jose/v4@v4.1.6 \
            --replace go.opentelemetry.io/otel=go.opentelemetry.io/otel@v1.45.0 \
            --replace go.opentelemetry.io/otel/sdk=go.opentelemetry.io/otel/sdk@v1.45.0 \
            --replace go.opentelemetry.io/otel/sdk/log=go.opentelemetry.io/otel/sdk/log@v0.21.0 \
            --replace go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc=go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc@v0.21.0 \
            --replace go.opentelemetry.io/contrib/exporters/autoexport=go.opentelemetry.io/contrib/exporters/autoexport@v0.70.0 \
        && break; \
        if [ "$attempt" = 4 ]; then echo "xcaddy build failed 4 times; giving up" >&2; exit 1; fi; \
        echo "xcaddy build attempt $attempt failed (a module fetch or a checksum-database stream error); retrying in $((attempt * 20))s" >&2; \
        sleep $((attempt * 20)); \
    done

FROM caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

# Every Polaris image carries the same provenance labels; the version is
# passed in by scripts/polaris-image-build.sh from polaris_web/__version__.py.
LABEL org.opencontainers.image.title="Polaris (TLS edge)"
LABEL org.opencontainers.image.description="Caddy edge for Polaris, built with the post-quantum key-exchange module"
LABEL org.opencontainers.image.source="https://github.com/EgorKhaklin/polaris-id"
LABEL org.opencontainers.image.licenses="Apache-2.0"
ARG POLARIS_VERSION=0.0-unstamped
LABEL org.opencontainers.image.version="${POLARIS_VERSION}"


# v9.138 — apk upgrade pulls patched packages on top of the pinned base so the
# built edge image clears fixable apk-package CVEs (Trivy gates on fixable CRITICAL).
RUN apk upgrade --no-cache

# Swap the stock binary for the plugin-enabled one; the base image's ENTRYPOINT
# (caddy run --config /etc/caddy/Caddyfile) and non-root posture are preserved.
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
# v9.186 (roadmap P1.5) — the runtime base sets cap_net_bind_service on the caddy
# binary as a FILE capability; a non-root user with all capabilities dropped (the
# restricted Pod Security Standard) then cannot exec it at all ("operation not
# permitted", found by the kind drill). Every profile listens on 8080/8443 as
# uid 1000 (v9.239 brought compose in line with the chart), so the file
# capability is stripped and nothing adds one back.
RUN apk add --no-cache libcap && setcap -r /usr/bin/caddy && apk del libcap

# Fail the build if the plugin did not actually land in the binary (defense in
# depth against a silently-broken xcaddy build shipping a plugin-less Caddy).
RUN caddy list-modules | grep -q '^http.handlers.rate_limit$'

# Fail the build if the copied binary is not the release the runtime base names:
# an update once moved the runtime to 2.11.7 while the compile stage still built
# 2.11.6. The official images set CADDY_VERSION (the compile stage's ENV does not
# reach this stage), and an empty one fails.
RUN test -n "$CADDY_VERSION" && [ "$(caddy version | awk '{print $1}')" = "$CADDY_VERSION" ]

# v9.239 — the edge runs as a non-root user everywhere, not only under the
# Kubernetes profile. uid 1000 matches the chart's pod security context and the
# app image, so one ownership rule covers every substrate. Caddy listens on
# 8080/8443 (the Caddyfile's http_port/https_port) and the host publishes
# 80/443 onto them, so no capability is needed to bind. /data holds the ACME
# account and certificates and /config Caddy's autosave; a named volume seeded
# from this image inherits the ownership, and polaris-deploy.sh corrects the
# volumes of a deployment created before this change.
RUN addgroup -g 1000 -S caddy && adduser -u 1000 -G caddy -S -H -s /sbin/nologin caddy && \
    chown -R caddy:caddy /data /config
USER caddy:caddy
