# ============================================================================
# Dockerfile.etcd — the distributed configuration store of the HA profile
# (v9.243, roadmap P2.7).
#
# Patroni keeps the leader lease in etcd: a node that cannot renew its lease
# stops being the primary, which is the property that makes automated failover
# safe. Self-built from etcd's release source on the same digest-pinned base as
# the pooler: the third-party etcd images run as root and live on registries
# the rest of the stack does not use, while this one runs as a dedicated user,
# is rebuilt by scripts/polaris-image-build.sh with every other image, and is
# scanned by the same CVE job. Only the HA profile (docker-compose.ha.yml) uses
# it. The source is one etcd release, named by its tag and checked against that
# tag's commit, so a new release or a new series is taken on purpose by editing
# both (lab record 017). etcd's own scripts/build.sh compiles it, with the Go
# release its go.mod names (the toolchain line) and the module versions it
# pins, verified against its go.sum.
# The pin moves by hand to each v3.6 patch release etcd publishes; the weekly
# image scan fails on a fixable critical CVE in the pinned release.
# ============================================================================
FROM golang:1.26.10-alpine3.24@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS compile
ARG ETCD_VERSION=v3.6.16
ARG ETCD_COMMIT=0b065e61c679ea81f6862bb24c9815f7fc673966
RUN apk add --no-cache bash git
WORKDIR /src
RUN git clone --quiet --depth 1 --branch "$ETCD_VERSION" https://github.com/etcd-io/etcd.git .
RUN [ "$(git rev-parse HEAD)" = "$ETCD_COMMIT" ] \
    || { echo "etcd $ETCD_VERSION is commit $(git rev-parse HEAD), not $ETCD_COMMIT" >&2; exit 1; }
# etcd's server, etcdctl and etcdutl modules reach their sibling modules (api, client/pkg,
# client/v3, pkg, server) through replace directives to the checkout's own directories, which
# leaves those modules without a version in the binaries, so no scanner can look them up. Each
# such replace is dropped and the module is taken at the release version from the module proxy:
# the checksum database verifies the download, and the downloaded module must match its
# directory at ETCD_COMMIT file for file (a module zip holds no symbolic links, so the
# comparison leaves them out). Go then stamps each main module v3.6.16+dirty, as its go.mod and
# go.sum differ from the tag.
RUN for m in server etcdctl etcdutl; do \
        reps=$(cd "$m" && go list -m -f '{{if .Replace}}{{.Path}} {{.Replace.Path}}{{end}}' all) \
            && [ -n "$reps" ] \
            || { echo "$m: no replace directive found" >&2; exit 1; }; \
        printf '%s\n' "$reps" | while read -r mod dir; do \
            [ -n "$mod" ] || continue; \
            p=${dir#../}; \
            case "$dir" in ../*) ;; *) p= ;; esac; \
            case "$p" in ''|*..*) echo "$m: $mod is replaced by $dir, not a sibling directory" >&2; exit 1 ;; esac; \
            git cat-file -e "$ETCD_COMMIT:$p/go.mod" \
                && (cd "$m" && go mod edit -dropreplace="$mod") \
                && ver=$(cd "$m" && go list -m -f '{{.Version}}{{if .Replace}} replaced{{end}}' "$mod") \
                && { [ "$ver" = "$ETCD_VERSION" ] \
                    || { echo "$m: $mod resolves to $ver, not $ETCD_VERSION" >&2; exit 1; }; } \
                && (cd "$m" && GOSUMDB=sum.golang.org GONOSUMDB= GOPRIVATE= GOFLAGS= go mod download "$mod@$ETCD_VERSION") \
                && moddir=$(cd "$m" && go list -m -f '{{.Dir}}' "$mod") && [ -n "$moddir" ] \
                && rm -rf /tmp/etcd-tag && mkdir /tmp/etcd-tag \
                && git archive -o /tmp/etcd-tag.tar "$ETCD_COMMIT" "$p" \
                && tar -x -f /tmp/etcd-tag.tar -C /tmp/etcd-tag \
                && links=$(find "/tmp/etcd-tag/$p" -type l | wc -l) \
                && find "/tmp/etcd-tag/$p" -type l -delete \
                && { diff -r "$moddir" "/tmp/etcd-tag/$p" >&2 \
                    || { echo "$m: $mod $ETCD_VERSION differs from $p at $ETCD_COMMIT" >&2; exit 1; }; } \
                && echo "$m: $mod $ETCD_VERSION matches $p at $ETCD_COMMIT ($links symbolic links left out)" \
                || exit 1; \
        done || exit 1; \
        left=$(grep -c '=> \.\./' "$m/go.mod"); \
        [ "$left" = 0 ] || { echo "$m: $left replace directive(s) to a sibling directory left" >&2; exit 1; }; \
    done
RUN CGO_ENABLED=0 ./scripts/build.sh
# etcd v3.6.16's go.mod names go1.26.10 as its toolchain but requires only go 1.26.0, so an older
# Go here would compile it without complaint: fail the build unless both binaries report go1.26.10
# or a later release.
RUN for b in bin/etcd bin/etcdctl; do \
        v=$(go version "$b" | sed 's/^.*: go//'); \
        case "$v" in \
            1.26.1[0-9]|1.26.[2-9][0-9]|1.2[7-9].[0-9]*|1.[3-9][0-9].[0-9]*) echo "$b: go$v" ;; \
            *) echo "$b reports go$v, older than go1.26.10" >&2; exit 1 ;; \
        esac; \
    done
# Every module in both binaries carries a version, and none is replaced.
RUN for b in bin/etcd bin/etcdctl; do \
        info=$(go version -m "$b") && [ -n "$info" ] || exit 1; \
        case "$info" in \
            *"=>"*|*"(devel)"*) printf '%s\n' "$info" >&2; echo "$b: a replaced or unversioned module" >&2; exit 1 ;; \
        esac; \
        printf '%s\n' "$info" | grep 'go\.etcd\.io/etcd/'; \
    done

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
LABEL org.opencontainers.image.title="Polaris (etcd)"
LABEL org.opencontainers.image.description="etcd for the Polaris HA profile: Patroni's leader lease and cluster state"
LABEL org.opencontainers.image.source="https://github.com/EgorKhaklin/polaris-id"
LABEL org.opencontainers.image.licenses="Apache-2.0"
ARG POLARIS_VERSION=0.0-unstamped
LABEL org.opencontainers.image.version="${POLARIS_VERSION}"
# The etcd user keeps the uid and gid Alpine's etcd package gave it (100 and 101), so a data
# volume an earlier image wrote stays readable.
RUN apk upgrade --no-cache \
    && addgroup -S -g 101 etcd \
    && adduser -S -D -H -h /dev/null -s /sbin/nologin -u 100 -G etcd -g etcd etcd \
    && mkdir -p /var/lib/etcd \
    && chown etcd:etcd /var/lib/etcd \
    && chmod 0700 /var/lib/etcd \
    && rm -rf /var/cache/apk/*
COPY --from=compile /src/bin/etcd /src/bin/etcdctl /usr/bin/
RUN etcd --version | head -1 && etcdctl version | head -1
USER etcd
VOLUME /var/lib/etcd
EXPOSE 2379 2380
ENTRYPOINT ["/usr/bin/etcd"]
CMD ["--data-dir", "/var/lib/etcd"]
